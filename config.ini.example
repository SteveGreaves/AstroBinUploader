[defaults]
        IMAGETYP = LIGHT
        EXPOSURE = 0
        DATE-OBS = 2023-01-01
        XBINNING = 1
        GAIN = -1
        EGAIN = -1
        INSTRUME = None
        TELESCOP = None
        FOCNAME = None
        FWHEEL = None
        ROTNAME = None
        ROTANTANG = 0
        XPIXSZ = 3
        CCD-TEMP = -10
        FOCALLEN = 540
        FOCRATIO = 5
        SITE = My Site Name
        SITELAT = 0.0000
        SITELONG = 0.0000
        BORTLE = 4
        SQM = 21
        FILTER = No Filter
        OBJECT = No target
        FOCTEMP = 20
        HFR = 1
        FWHM = 0
        SWCREATE = Unknown package
        USEOBSDATE = False
[override]
        SWCREATE = CREATOR
        EXPOSURE = EXPTIME
        SITE = SITENAME
        FOCNAME = FOCUSER
        SQM = AOCSKYQ, AOCSKYQU
        FOCTEMP = AOCAMBT
[equipmentoverrides]
        # Force a display value for equipment fields when the header
        # text is unhelpful (e.g. NINA writes "EAF" not "ZWO EAF").
        # "None" = leave the value as found.
        INSTRUME = None
        TELESCOP = None
        FOCNAME = None
        FWHEEL = None
        ROTNAME = None
[filters]
        #Filter     code
        Ha = 4663
        SII = 4844
        OIII = 4752
        Red = 4649
        Green = 4643
        Blue = 4637
        Lum = 2906
        CLS = 4632
[secret]
        # OPTIONAL. Delete this whole section to keep the program entirely
        # offline -- it then takes the site name from [defaults] SITE and the
        # sky quality from [defaults] BORTLE/SQM, and contacts nothing.
        #
        # With it, a coordinate that [sites] does not already know is resolved
        # once: the address comes from OpenStreetMap's Nominatim service, and
        # the Bortle/SQM from lightpollutionmap.info's World Atlas 2015 layer.
        # The result is written back into [sites] below, so it is never looked
        # up twice. Any failure falls back to the [defaults] values.
        #
        # EMAIL_ADDRESS is required by Nominatim's terms of service as a
        # contact for the request; it is sent in the user agent and nowhere
        # else. Get a free API key from https://www.lightpollutionmap.info.
        #API key         API endpoint
        YOUR_API_KEY = https://www.lightpollutionmap.info/QueryRaster/
        EMAIL_ADDRESS = your_email@example.com
[sites]
        [["My Full Site Address, Country, Postcode"]]
                latitude = 0.0000
                longitude = 0.0000
                bortle = 4
                sqm = 21